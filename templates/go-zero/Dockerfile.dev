# Go-Zero 开发环境 Dockerfile
# 支持热重载

FROM golang:1.21-alpine

# 安装开发工具
RUN apk add --no-cache git make && \
    go install github.com/cosmtrek/air@latest

ENV GO111MODULE=on \
    GOPROXY=https://goproxy.cn,direct

WORKDIR /app

# 复制依赖文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源码
COPY . .

EXPOSE 8080

# 使用 air 热重载
CMD ["air", "-c", ".air.toml"]
